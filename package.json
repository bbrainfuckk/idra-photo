{
  "name": "idra-photo",
  "version": "0.1.0",
  "description": "Your AI generates. Idra manages the batch. Local stdio MCP server that hands a host agent one image job at a time and keeps durable, duplicate-resistant batch state.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "idra-photo": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "docs/architecture.md",
    "docs/compatibility.md",
    "docs/overhead.md",
    "docs/testing.md",
    "examples/codex",
    "examples/prompts.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run bundle && node --test \"dist/tests/**/*.test.js\"",
    "simulate": "node dist/src/cli.js simulate",
    "overhead": "npm run build && node dist/tests/bench/overhead.js",
    "pack:check": "npm run build && node dist/tests/bench/pack-install-check.js",
    "clone:check": "npm run build && node dist/tests/bench/clone-check.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
